# Supabase Configuration
# Lấy các thông số này từ Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Ghi chú: Gemini API Key sẽ được người dùng nhập trực tiếp trong giao diện Cài đặt (Settings)
# và lưu an toàn trong Cookie trình duyệt của người dùng (Client-side Cookie).
